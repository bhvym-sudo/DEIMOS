FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY ai_service/requirements.worker.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && python -m spacy download en_core_web_sm
COPY phobos/analysis/ /app/phobos/analysis/
COPY phobos/scripts/ /app/phobos/scripts/
COPY phobos/models/ /app/phobos/models/
COPY phobos/config_files/intelligence_data_new.json /app/phobos/intelligence_data_new.json
WORKDIR /app/phobos
CMD ["python", "scripts/utils/run_processor.py"]
